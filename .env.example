# کپی کنید به .env (برای توسعه محلی) یا در تنظیمات محیطی پلتفرم وارد کنید. هرگز مقدار واقعی را commit نکنید.

# رشته اتصال PostgreSQL، مثال: postgresql://user:pass@host:5432/dbname
DATABASE_URL=

# کلید رمزنگاری رمز عبورها (طولانی و تصادفی؛ مثلاً: openssl rand -hex 32)
APP_SECRET=

# رمز endpoint زمان‌بندی /api/cron/run (مثلاً: openssl rand -hex 24)
CRON_SECRET=
